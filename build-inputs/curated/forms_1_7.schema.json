      "eq": true,
      "show": [
        "re_hours",
        "re_fee_per_class",
        "risk_education_info"
      ]
    },
    {
      "if": "program_ei",
      "eq": true,
      "show": [
        "ei_hours",
        "ei_fee_per_class",
        "early_intervention_info"
      ]
    },
    {
      "if": "program_op",
      "eq": true,
      "show": [
        "op_hours",
        "op_fee_per_session",
        "outpatient_info"
      ]
    },
    {
      "if": "program_ccp",
      "eq": true,
      "show": [
        "ccp_months",
        "ccp_fee_per_session",
        "continuing_care_info"
      ]
    }
  ]
}