# Ver blueprint Sección 13 (Environment Setup) para dónde obtener cada valor.
# Copia este archivo a .env.local para desarrollo. NUNCA commitees .env ni .env.local.

# --- M1 ---
# Connection string del rol app_user (Neon, proyecto con HIPAA habilitado, plan Scale).
# JAMÁS la del owner — ver src/lib/db/client.ts y drizzle/sql/0001_rls_and_roles.sql.
DATABASE_URL=

# Connection string del OWNER — solo la usa drizzle-kit para crear tablas/roles/policies.
# No la importa ningún archivo de la app en runtime.
DATABASE_URL_MIGRATIONS=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

RESEND_API_KEY=

# --- M2 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- M5 (opcional, solo con BAA de Sentry + scrubbing activo) ---
SENTRY_DSN=
